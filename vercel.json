
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/capabilities/cloud", "destination": "/capabilities#cloud", "permanent": true },
    { "source": "/capabilities/security", "destination": "/capabilities#security", "permanent": true },
    { "source": "/capabilities/managed-it", "destination": "/capabilities#managed-it", "permanent": true },
    { "source": "/capabilities/it-infrastructure", "destination": "/capabilities#it-infrastructure", "permanent": true },
    { "source": "/capabilities/data-analytics", "destination": "/capabilities#data-analytics", "permanent": true },
    { "source": "/capabilities/digital-workspace", "destination": "/capabilities#digital-workspace", "permanent": true },
    { "source": "/capabilities/erp-applications", "destination": "/capabilities#erp-applications", "permanent": true },
    { "source": "/capabilities/tech-talent", "destination": "/capabilities#tech-talent", "permanent": true },
    { "source": "/capabilities/maintenance-amc", "destination": "/capabilities#maintenance-amc", "permanent": true },
    { "source": "/capabilities/managed-print", "destination": "/capabilities#managed-print", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(home|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
